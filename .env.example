# Local development values only. Replace every value before deployment.
DB_PASSWORD=replace-with-32+-char-random-secret
REDIS_PASSWORD=replace-with-32+-char-random-secret
SECUREMCP_BOOTSTRAP_ENABLED=true
SECUREMCP_BOOTSTRAP_CLIENT_ID=securemcp-local-client
SECUREMCP_BOOTSTRAP_CLIENT_SECRET=replace-with-32+-char-random-secret
SECUREMCP_ISSUER=http://localhost:8080
SECUREMCP_AUDIENCE=securemcp-api
SERVER_PORT=8080
KEYCLOAK_ENABLED=false
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-long-random-secret
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_JWK_PATH=secret/data/securemcp/signing
VAULT_DEV_TOKEN=local-vault-dev-token
SECUREMCP_JWK_SET_FILE=

SECUREMCP_ALLOW_EPHEMERAL_KEYS=true
MCP_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080
KEYCLOAK_ISSUER=http://localhost:8180/realms/securemcp
KEYCLOAK_AUDIENCE=securemcp-api
REDIS_SSL_ENABLED=false
